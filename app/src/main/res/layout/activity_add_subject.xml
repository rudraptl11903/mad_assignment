<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:theme="@style/Theme.Material3.Light.NoActionBar">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_marginStart="20dp"
        android:gravity="center_vertical"
        android:text="←  Add Subject"
        android:textColor="@color/blue"
        android:textSize="20sp"
        android:textStyle="bold"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/labelSubject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:text="Subject Name"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etSubject"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card"
        android:hint="Android Development"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/labelSubject"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/labelTeacher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:text="Teacher Name"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etSubject"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etTeacher"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card"
        android:hint="Prof. Patel"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/labelTeacher"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/labelDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:text="Day"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/etTeacher"
        app:layout_constraintStart_toStartOf="parent"/>

    <Spinner
        android:id="@+id/spDay"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card"
        app:layout_constraintTop_toBottomOf="@id/labelDay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/labelStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:text="Start Time"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/spDay"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btnStartTime"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="09:00 AM"
        app:layout_constraintTop_toBottomOf="@id/labelStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/labelEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="7dp"
        android:text="End Time"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnStartTime"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btnEndTime"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="10:00 AM"
        app:layout_constraintTop_toBottomOf="@id/labelEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/labelRoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="7dp"
        android:text="Room Number"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnEndTime"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etRoom"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card"
        android:hint="A-101"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/labelRoom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_margin="20dp"
        android:text="ADD SUBJECT"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/etRoom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
