<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup configuration rules for AI Timetable Generator
   Controls which files and preferences are saved during Google Cloud Auto Backup
   See: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Include local user preferences and saved timetable subjects -->
    <include domain="sharedpref" path="timetable_prefs.xml" />
    <include domain="sharedpref" path="app_settings.xml" />
</full-backup-content>
